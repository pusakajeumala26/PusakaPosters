generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  L
  P
}

enum PosterStatus {
  MASUK
  DESAIN
  SIAP
  POSTING
}

model Member {
  id           String       @id @default(uuid())
  name         String
  /// Nama folder di Supabase Storage: "<slug-nama>-<8 huruf id>"
  folder       String       @unique
  countryCode  String
  /// Hanya digit, tanpa nol di depan dan tanpa kode negara
  phone        String
  quote        String
  gender       Gender
  passwordHash String
  /// Path di bucket, mis. "nurul-aini-safira-1a2b3c4d/original.webp"
  originalPath String?
  cutoutPath   String?
  status       PosterStatus @default(MASUK)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([countryCode, phone])
  @@index([createdAt])
  @@index([status])
}

/// Baris tunggal (id = 1)
model Setting {
  id                Int       @id @default(1)
  letingName        String    @default("Pusaka Jeumala")
  target            Int       @default(120)
  deadline          DateTime?
  uploadOpen        Boolean   @default(true)
  adminPasswordHash String?
  /// Dinaikkan setiap password admin diganti, supaya sesi lama tidak berlaku
  adminPwVersion    Int       @default(0)
}

enum FeedbackSync {
  QUEUED
  SENT
  FAILED
}

/// Masukan publik. Selalu disimpan di sini lebih dulu, lalu dikirim ke portfolio lewat antrean.
model Feedback {
  id            String       @id @default(uuid())
  name          String
  role          String?
  message       String
  rating        Int
  /// Path foto profil (prefix "feedback/") di Supabase Storage; tidak dikirim ke portfolio
  avatarKey     String?
  syncStatus    FeedbackSync @default(QUEUED)
  attempts      Int          @default(0)
  /// Jenis kegagalan terakhir: dns, network, timeout, unauthorized, rate_limited, server, invalid
  lastError     String?
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?
  /// Ada percobaan yang hasilnya tidak pasti (timeout/5xx): kemungkinan sudah diterima portfolio
  uncertain     Boolean      @default(false)
  remoteId      String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([syncStatus, nextAttemptAt])
  @@index([createdAt])
}

/// Baris tunggal (id = 1): koneksi MCP portfolio yang diatur dari halaman Pengaturan admin
model PortfolioConnection {
  id           Int       @id @default(1)
  url          String?
  /// API key terenkripsi AES-256-GCM; tidak pernah dikirim ke browser
  keyEnc       String?
  /// Empat karakter terakhir key untuk tampilan tersamar
  keyHint      String?
  connected    Boolean   @default(false)
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  lastTestKind String?
  lastTestMs   Int?
  lastTestNote String?
  updatedAt    DateTime  @updatedAt
}
