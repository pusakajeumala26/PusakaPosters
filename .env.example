# --- NeonDB (Postgres) ---
# DATABASE_URL: connection string "pooled" (host mengandung -pooler). Dipakai aplikasi saat runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: connection string langsung (tanpa -pooler). Dipakai Prisma untuk migrasi.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Supabase Storage (hanya dipakai di server, JANGAN diberi awalan NEXT_PUBLIC_) ---
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# service_role key (atau secret key baru berawalan sb_secret_)
SUPABASE_SERVICE_ROLE_KEY=""
# Nama bucket (private). Dibuat otomatis kalau belum ada.
SUPABASE_BUCKET="member-photos"

# --- Admin ---
# Password admin awal. Setelah diganti lewat halaman Pengaturan, nilai ini tidak dipakai lagi.
ADMIN_PASSWORD=""
# Kunci penanda tangan cookie sesi admin. Buat dengan: openssl rand -base64 32
SESSION_SECRET=""

# --- Opsional: mesin segmentasi di browser ---
# "mediapipe" (default, model di-host sendiri di /public/mediapipe) atau "tfjs"
# NEXT_PUBLIC_SEGMENTER_RUNTIME="mediapipe"
# Hanya untuk runtime tfjs: URL model.json hasil host sendiri
# NEXT_PUBLIC_SEGMENTER_MODEL_URL=""

# URL dan API key MCP portfolio diatur dari Pengaturan admin (tersimpan terenkripsi di database).
# Opsional: rahasia untuk Vercel Cron /api/cron/feedback (Authorization: Bearer ...).
CRON_SECRET=""
